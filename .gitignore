# ============================================================
# .gitignore —— 让这些东西永远不进仓库
# 说明：这个文件本身要提交（它才是"排除规则"）。
#      写完它再 `git add .`，下面这些就不会被加进来。
# ============================================================

# ---- Python 缓存 / 编译产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- 虚拟环境（如果哪天在仓库里建了 venv）----
.venv/
venv/
env/
.venv310/

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 测试 / 类型检查缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Windows / macOS 的系统垃圾 ----
desktop.ini
Thumbs.db
.DS_Store
__MACOSX/

# ---- Office 临时锁文件（打开 docx/pptx 时会冒出来的 ~$ 文件）----
~$*

# ---- 日志、临时、备份 ----
*.log
*.tmp
*.bak
*.log.*

# ---- 本机跑出来的输出（out/ 里的结果要不要提交由你定）----
# 想提交示例输出就把下面两行注释掉；不想提交就保持原样。
# out/**/*.tmp
# out/**/*.log
